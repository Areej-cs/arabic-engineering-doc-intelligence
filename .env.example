# Copy to .env and adjust. Every value here has a sensible default, so .env is optional
# for a quick local run.

# ==== App ====
APP_NAME="Arabic Engineering Document Intelligence"
APP_ENV=development           # development | production
DEBUG=true

# ==== API ====
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:8501"]
MAX_UPLOAD_MB=15

# ==== Database ====
# Local quick start (no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./local.db
# PostgreSQL (docker-compose sets this automatically):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arabic_doc_intel

# ==== Storage for uploaded originals ====
STORAGE_BACKEND=local          # local | s3
AWS_REGION=me-south-1
S3_BUCKET_NAME=arabic-eng-doc-intelligence
# On EC2 use an IAM role instead of keys. Only set keys for local testing against real S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ==== OCR ====
OCR_ENGINE=tesseract           # tesseract | easyocr (needs requirements-optional.txt)
TESSERACT_LANG=ara+eng
TESSERACT_CMD=
TESSDATA_PREFIX=               # dir containing *.traineddata (e.g. ara.traineddata) if not in the default Tesseract install
POPPLER_PATH=                  # poppler "bin" dir, needed by pdf2image if poppler isn't on PATH

# ==== NLP ====
ARABERT_MODEL_NAME=aubmindlab/bert-base-arabertv02
DEVICE=cpu                     # cpu | cuda

# ==== Streamlit dashboard ====
STREAMLIT_MODE=local           # local = run the pipeline in-process | api = call the FastAPI service
STREAMLIT_API_BASE_URL=http://localhost:8000/api/v1
