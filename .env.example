# ==== App ====
APP_NAME="Arabic Engineering Document Intelligence"
APP_ENV=development           # development | staging | production
DEBUG=true
SECRET_KEY=change-me

# ==== API ====
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arabic_doc_intel

# ==== AWS ====
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=arabic-eng-doc-intelligence
USE_AWS_TEXTRACT=false        # true = use Textract for OCR, false = local OCR engine

# ==== OCR ====
OCR_ENGINE=tesseract           # tesseract | easyocr | textract
TESSERACT_LANG=ara+eng
TESSERACT_CMD=

# ==== NLP / Models ====
ARABERT_MODEL_NAME=aubmindlab/bert-base-arabertv2
NER_MODEL_PATH=models_store/ner
CLASSIFIER_MODEL_PATH=models_store/classifier
DEVICE=cpu                     # cpu | cuda

# ==== Streamlit ====
STREAMLIT_API_BASE_URL=http://localhost:8000/api/v1
