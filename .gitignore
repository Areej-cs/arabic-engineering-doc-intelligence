# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example
*.pem
*.key
aws_credentials*

# Models & large artifacts (use S3 / DVC / LFS instead)
saved_models/*
!saved_models/.gitkeep
*.bin
*.safetensors
*.pt
*.onnx
*.h5

# Data (raw/processed docs may contain sensitive info)
data/raw/*
data/processed/*
data/annotated/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/annotated/.gitkeep
!data/samples/

# Jupyter
.ipynb_checkpoints/
training/notebooks/*.ipynb_checkpoints

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# Claude Code (local settings/session state)
.claude/

# OS
.DS_Store
Thumbs.db

# Terraform
deployment/aws/terraform/.terraform/
deployment/aws/terraform/*.tfstate
deployment/aws/terraform/*.tfstate.backup
deployment/aws/terraform/.terraform.lock.hcl

# Logs
*.log
logs/

# Docker
.dockerignore
